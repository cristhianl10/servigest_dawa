# ==========================================
# SERVIGEST ECUADOR — VARIABLES DE ENTORNO
# ==========================================

# Configuración del Backend
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://servigest:servigest@localhost:5432/servigest?schema=public

# Credenciales DB Docker
POSTGRES_USER=servigest
POSTGRES_PASSWORD=servigest
POSTGRES_DB=servigest

# Seguridad y Autenticación
JWT_SECRET=super_secret_jwt_key_servigest_2026_dawa_development_only
JWT_ISSUER=servigest-api
JWT_AUDIENCE=servigest-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Integración y Origen
CORS_ORIGIN=http://localhost:5173
WEB_URL=http://localhost:5173
APP_TIMEZONE=America/Guayaquil

# Almacenamiento local de adjuntos
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# Configuración de logs y rate limiting
LOG_LEVEL=info
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MIN=15

# Configuración del Frontend
VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME=ServiGest Ecuador
